000409  1                   .endif
000409  1               
000409  1               ; IRQ & NMI test - requires a feedback register
000409  1                   .if I_drive > 1
000409  1                       .error "invalid interrupt drive!"
000409  1                   .endif
000409  1                 .if NMI_bit < 0
000409  1                   .if I_drive = 0      ;totem pole (push/pull, 0 -> I_port to force interrupt)
000409  1                       .macro  I_set  ibit   ;ibit = interrupt bit
000409  1                       lda I_port      ;turn on interrupt by bit
000409  1                       and #I_filter-(1<<ibit)
000409  1                       plp             ;set flags
000409  1                       pha             ;save to verify
000409  1                       php
000409  1                       sta I_port      ;interrupt next instruction plus outbound delay
000409  1                       .endmacro
000409  1                       .macro  I_clr  ibit  ;ibit = interrupt bit
000409  1                       lda I_port      ;turn off interrupt by bit
000409  1                       and #I_filter
000409  1                       ora #(1<<ibit)
000409  1                       sta I_port
000409  1                       .endmacro
000409  1                       I_clr   IRQ_bit ;turn off IRQ
000409  1                     .if I_ddr <> 0     ;with DDR
000409  1                       lda I_ddr       ;set DDR for IRQ to enabled
000409  1                       and #I_filter
000409  1                       ora #(1<<IRQ_bit)
000409  1                       sta I_ddr
000409  1                     .endif
000409  1                   .else                ;open collector, 0 -> I_DDR or I_port to force interrupt
000409  1                     .if I_ddr <> 0     ;with DDR
000409  1                       .macro  I_set  ibit  ;ibit = interrupt bit
000409  1                       lda I_ddr       ;turn on interrupt by bit
000409  1                       and #I_filter
000409  1                       ora #(1<<ibit)
000409  1                       plp             ;set flags
000409  1                       pha             ;save to verify
000409  1                       php
000409  1                       sta I_ddr       ;interrupt next instruction plus outbound delay
000409  1                       .endmacro
000409  1                       .macro  I_clr  ibit     ;ibit = interrupt bit
000409  1                       lda I_ddr       ;turn off interrupt by bit
000409  1                       and #I_filter-(1<<ibit)
000409  1                       sta I_ddr
000409  1                       .endmacro
000409  1                       I_clr   IRQ_bit ;turn off IRQ
000409  1                       lda I_port      ;precharge IRQ
000409  1                       and #I_filter-(1<<IRQ_bit)
000409  1                       sta I_port
000409  1                     .else              ;no DDR
000409  1                       .macro  I_set  ibit  ;ibit = interrupt bit
000409  1                       lda I_port      ;turn on interrupt by bit
000409  1                       and #I_filter
000409  1                       ora #(1<<ibit)
000409  1                       plp             ;set flags
000409  1                       pha             ;save to verify
000409  1                       php
000409  1                       sta I_port      ;interrupt next instruction plus outbound delay
000409  1                       .endmacro
000409  1                       .macro  I_clr  ibit ;ibit = interrupt bit
000409  1                       lda I_port      ;turn off interrupt by bit
000409  1                       and #I_filter-(1<<ibit)
000409  1                       sta I_port
000409  1                       .endmacro
000409  1                       I_clr   IRQ_bit ;turn off IRQ
000409  1                     .endif
000409  1                   .endif
000409  1                 .else
000409  1                   .if I_drive = 0      ;totem pole (push/pull, 0 -> I_port to force interrupt)
