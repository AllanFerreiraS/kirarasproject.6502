00000B  1  00           irq_x:  .res    1,0         ;x register
00000C  1  00           irq_f:  .res    1,0         ;flags
00000D  1  00           nmi_a:  .res    1,0         ;a register
00000E  1  00           nmi_x:  .res    1,0         ;x register
00000F  1  00           nmi_f:  .res    1,0         ;flags
000010  1               zp_bss:
000010  1               
000010  1               ;fixed stack locations
