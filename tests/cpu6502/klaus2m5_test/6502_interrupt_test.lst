000785  1  68                   pla
000786  1  48                   pha
000787  1  85 0C                sta irq_f
000789  1  AD 03 02             lda I_src       ;IRQ expected?
00078C  1  29 03                and #3
00078E  1  F0 FE                trap_eq         ;unexpexted IRQ/BRK - check stack for conditions
000790  1  68                   pla             ;test I-flag was set
000791  1  48                   pha
000792  1  29 04                and #intdis
000794  1  F0 FE                trap_eq         ;I-flag not set
000796  1  68                   pla             ;return with other flags reversed
000797  1  49 C3                eor #m8-fai-decmode
000799  1  48                   pha
00079A  1  BA                   tsx
00079B  1  BD 02 01             lda $102,x      ;test break on stack
00079E  1  29 10                and #break
0007A0  1  D0 21                bne brk_trap
0007A2  1               
0007A2  1  AD 03 02             lda I_src       ;IRQ expected?
0007A5  1  29 02                and #2
0007A7  1  F0 FE                trap_eq         ;unexpexted IRQ - check stack for conditions
0007A9  1  AD 03 02             lda I_src       ;mark expected IRQ has occured
0007AC  1  29 FD                and #$ff-2
0007AE  1  8D 03 02             sta I_src
0007B1  1  AD FC BF 29          I_clr   IRQ_bit
0007B5  1  7E 8D FC BF  
0007B9  1  A6 0B                ldx irq_x
0007BB  1  E8                   inx
0007BC  1  8E 01 02             stx irq_count
0007BF  1  A9 51                lda #'Q'        ;mark (IR)Q
0007C1  1  28                   plp             ;should be reversed by rti
0007C2  1  40                   rti
0007C3  1               
0007C3  1               brk_trap:
0007C3  1  AD 03 02             lda I_src       ;break expected?
0007C6  1  29 01                and #1
0007C8  1  F0 FE                trap_eq         ;unexpected BRK - check stack for conditions
0007CA  1  AD 03 02             lda I_src       ;mark expected BRK has occured
0007CD  1  29 FE                and #$ff-1
0007CF  1  8D 03 02             sta I_src
0007D2  1  A6 0B                ldx irq_x
0007D4  1  E8                   inx
0007D5  1  8E 02 02             stx brk_count
0007D8  1  A5 0A                lda irq_a
0007DA  1  A9 4B                lda #'K'        ;mark (BR)K
0007DC  1  28                   plp             ;should be reversed by rti
0007DD  1  40                   rti
