000010  1                       .org data_segment
000200  1               ;concurrent NMI, IRQ & BRK test result
000200  1  00           nmi_count:  .res    1,0     ;lowest number handled first, $ff = never
000201  1  00           irq_count:  .res    1,0     ;separation-1 = instructions between interrupts
000202  1  00           brk_count:  .res    1,0
000203  1               ;expected interrupt mask
